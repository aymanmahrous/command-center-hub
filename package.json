{
  "name": "relaxfix-command-center-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5000",
    "build": "vite build && node scripts/check-performance-budget.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 5000",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:unit": "npm test",
    "test:security": "npm test",
    "test:contracts": "npm test",
    "verify:source": "npm run typecheck && npm run test:unit && npm run test:security && npm run test:contracts",
    "verify:ci": "npm run verify:source && npm run build",
    "verify:release": "npm run verify:ci",
    "verify": "npm run verify:ci"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "lucide-react": "^0.468.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
