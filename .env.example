# Public Supabase project URL used by the browser client.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Preferred browser-safe publishable key. Secret keys are rejected by the application.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY

# Legacy fallback for existing deployments only. If used, its JWT role must be `anon`.
VITE_SUPABASE_ANON_KEY=

# Staff profile table protected by RLS. The authenticated user UUID is the primary key `id`.
# Expected columns: id UUID, display_name TEXT, role TEXT, active BOOLEAN.
VITE_STAFF_PROFILE_TABLE=staff_profiles

# Optional in-app password reset route path (must start with `/`), for example `/auth/reset-password`.
VITE_PASSWORD_RESET_PATH=

# ---------------------------------------------------------------------------
# Edge Function secrets — documentation only. NEVER add a VITE_ prefix to
# these, never put real values in this file or any committed file, and
# never let them reach browser-bundled code. They are read only by
# `supabase/functions/safe-content-publisher` via Deno.env.get(...), and
# must be set directly with `supabase secrets set` (see that function's
# header comment for the exact command). SUPABASE_URL, SUPABASE_ANON_KEY,
# and SUPABASE_SERVICE_ROLE_KEY are injected automatically by the Edge
# Runtime and do not need to be set here or as secrets.
#
# META_PAGE_ACCESS_TOKEN=
# META_PAGE_ID=
# INSTAGRAM_BUSINESS_ACCOUNT_ID=
# META_GRAPH_VERSION=v21.0
