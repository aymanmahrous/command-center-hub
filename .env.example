# Public Supabase project URL used by the browser client.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Preferred browser-safe publishable key. Secret keys are rejected by the application.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY

# Legacy fallback for existing deployments only. If used, its JWT role must be `anon`.
VITE_SUPABASE_ANON_KEY=

# Staff profile table protected by RLS. The authenticated user UUID is the primary key `id`.
# Expected columns: id UUID, display_name TEXT, role TEXT, active BOOLEAN.
VITE_STAFF_PROFILE_TABLE=staff_profiles

# Optional in-app password reset route path (must start with `/`), for example `/auth/reset-password`.
VITE_PASSWORD_RESET_PATH=

# Optional public Google Drive folder for Massive Archive (folder link or ID only; no API).
VITE_MASSIVE_ARCHIVE_DRIVE_FOLDER_URL=

# Server-side only (Supabase Edge Function secret — never use VITE_*):
# GEMINI_API_KEY — Google AI Studio / Gemini API key for analyze-staff-media Edge Function.
# RUNWAY_API_KEY — Runway Developer API key (server-side only; separate from Runway Pro subscription).
# BUFFER_ACCESS_TOKEN — Buffer API token (server-side only; publishing blocked in current phase).
# N8N_WEBHOOK_URL — n8n inbound webhook URL (server-side only; webhook push, no polling).
