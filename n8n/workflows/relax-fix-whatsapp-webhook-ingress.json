      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "\nconst promptItem = $('Build AI Prompt').first().json;\nconst aiItem = $json || {};\nconst fallback = String(promptItem.fallbackReply || promptItem.draftReply || '').trim();\nlet aiText = '';\nif (typeof aiItem.message === 'string') aiText = aiItem.message;\nelse if (typeof aiItem.text === 'string') aiText = aiItem.text;\nelse if (typeof aiItem.output === 'string') aiText = aiItem.output;\nelse if (aiItem.message?.content) aiText = String(aiItem.message.content);\nelse if (Array.isArray(aiItem.messages) && aiItem.messages[0]?.content) aiText = String(aiItem.messages[0].content);\n\nconst approved = new Set(['150','200','450','400','50']);\nconst forbidden = /(guarantee|guaranteed|available tomorrow|free lesson|خصم إضافي|ضمان|درس مجاني)/i;\nfunction safe(text) {\n  const reply = String(text || '').trim();\n  if (!reply) return false;\n  if (forbidden.test(reply)) return false;\n  const chunks = reply.match(/\\d+(?:[.,]\\d+)?\\s*(?:AED|aed|dirham|درهم)/gi) || [];\n  for (const chunk of chunks) {\n    const amount = (chunk.match(/\\d+(?:[.,]\\d+)?/) || [''])[0].replace(/[.,]/g, '');\n    if (amount && !approved.has(amount)) return false;\n  }\n  return true;\n}\n\nconst usedAi = promptItem.aiAllowed === true && safe(aiText);\nconst draftReply = usedAi ? aiText.trim() : fallback;\nconst usage = aiItem.usage || aiItem.tokenUsage || {};\nreturn [{\n  json: {\n    ...promptItem,\n    draftReply,\n    fallbackReply: fallback,\n    aiReplySource: usedAi ? 'ai' : (promptItem.aiAllowed ? 'fallback_unsafe' : 'fallback_cost_cap'),\n    aiUsage: {\n      prompt_tokens: Number(usage.prompt_tokens || usage.promptTokens || 0) || 0,\n      completion_tokens: Number(usage.completion_tokens || usage.completionTokens || 0) || 0,\n      total_tokens: Number(usage.total_tokens || usage.totalTokens || 0) || 0\n    }\n  }\n}];\n"
      },
