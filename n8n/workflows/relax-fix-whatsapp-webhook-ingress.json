      "credentials": {
        "httpHeaderAuth": {
          "id": "WHATSAPP_GRAPH_BEARER_CREDENTIAL_ID",
          "name": "WhatsApp Graph Bearer"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\nconst draft = $json;\nconst webhookItems = $('Webhook').all();\nlet from = '';\nfor (const item of webhookItems) {\n  try {\n    const msgs = item.json.body.entry[0].changes[0].value.messages;\n    if (msgs && msgs[0] && msgs[0].from) {\n      from = String(msgs[0].from).replace(/^\\+/, '');\n      break;\n    }\n  } catch (e) {}\n}\nif (!from) {\n  try {\n    const msgs = $('Subscribe Verification?').item.json.body.entry[0].changes[0].value.messages;\n    from = String(msgs[0].from).replace(/^\\+/, '');\n  } catch (e) {}\n}\nif (!draft.draftReply || !from) {\n  return [{ json: { ...draft, outboundReady: false, outboundSkipReason: !draft.draftReply ? 'NO_DRAFT' : 'NO_FROM' } }];\n}\nreturn [{\n  json: {\n    ...draft,\n    outboundReady: true,\n    outboundPayload: {\n      messaging_product: 'whatsapp',\n      to: from,\n      type: 'text',\n      text: { body: String(draft.draftReply) }\n    }\n  }\n}];\n"
      },
