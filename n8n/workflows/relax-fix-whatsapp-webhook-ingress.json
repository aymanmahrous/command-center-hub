    {
      "parameters": {
        "jsCode": "\nconst draft = $('Should Send WhatsApp Reply?').first().json;\nconst claim = $json || {};\n\nlet customerMessage = String(draft.aiContext?.customerMessage || draft.customerMessage || '').trim();\nif (!customerMessage) {\n  try {\n    const msgs = $('Webhook').first().json.body.entry[0].changes[0].value.messages;\n    const m = msgs && msgs[0];\n    if (m?.text?.body) customerMessage = String(m.text.body).trim();\n    else if (m?.button?.text) customerMessage = String(m.button.text).trim();\n  } catch (e) {}\n}\n\nconst language = draft.language || (/[ء-ي]/.test(customerMessage) ? 'ar' : 'en');\nconst state = draft.aiContext?.state || String(draft.intent || '').replace(/^concierge:/, '') || 'awaiting_offer_type';\nconst approvedFacts = draft.aiContext?.approvedFacts || [\n  'Private lesson: 150 AED instead of 200 AED — limited-time offer.',\n  'Group lesson: up to 5 people — 450 AED.',\n  'Siblings discount: 50 AED off per sibling. Example: eligible sibling group = 400 AED instead of 450 AED.'\n];\nconst recent = Array.isArray(claim.recentMessages) ? claim.recentMessages : (draft.aiContext?.recentMessages || []);\nconst isFirstMessage = draft.aiContext?.isFirstMessage === true || recent.filter((m) => m.role === 'customer').length <= 1;\nconst allowed = claim.allowed === true && draft.humanHandoff !== true && !!draft.draftReply && draft.code === 'DRAFT_READY';\nconst facts = approvedFacts.map((f) => `- ${f}`).join('\\n');\nconst systemPrompt = [\n  'You are the WhatsApp sales concierge for Relax Fix UAE (swimming lessons).',\n  'Reply in the same language and dialect the customer used (Gulf Arabic, Arabic, or English).',\n  'Keep replies short (2-5 sentences), warm, and practical.',\n  'Never invent prices, discounts, schedules, guarantees, or services.',\n  'Use ONLY these approved commercial facts:',\n  facts,\n  `Current business state: ${state}.`,\n  'If unclear, ask one clarifying question instead of dumping the full price list.',\n  'Do not mention that you are an AI.'\n].join('\\n');\nconst history = recent.slice(-8).map((m) => `${m.role}: ${m.body}`).join('\\n');\nconst userPrompt = [\n  isFirstMessage ? 'This is the first customer message — include a brief friendly greeting.' : 'Continue the conversation naturally.',\n  `State: ${state}`,\n  `Detected language hint: ${language}`,\n  history ? `Recent messages:\\n${history}` : 'Recent messages: (none)',\n  `New customer message:\\n${customerMessage || '(empty)'}`,\n  'Write only the WhatsApp reply text.'\n].join('\\n\\n');\n\nreturn [{\n  json: {\n    ...draft,\n    aiBudget: claim,\n    aiAllowed: allowed,\n    systemPrompt,\n    userPrompt,\n    fallbackReply: draft.fallbackReply || draft.draftReply,\n    draftReply: draft.draftReply,\n    customerMessage\n  }\n}];\n"
      },
